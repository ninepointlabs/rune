[Desktop Entry]
Type=Application
Name=Rune
GenericName=Word Processor
Comment=A word processor that writes with you
Exec=rune %f
Icon=rune
Terminal=false
Categories=Office;WordProcessor;Qt;
Keywords=document;writer;word;odt;docx;text;AI;
MimeType=application/vnd.oasis.opendocument.text;application/vnd.openxmlformats-officedocument.wordprocessingml.document;application/msword;
StartupNotify=true
StartupWMClass=rune
